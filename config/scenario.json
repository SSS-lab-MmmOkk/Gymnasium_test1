      }
    },
    "C2_1_InitSpeed": {
      "Slow": {
        "dist": "normal",
        "mean": 20.0,
        "std": 2.0,
        "unit": "km/h"
      },
      "Target": {
        "dist": "normal",
        "mean": 30.0,
        "std": 2.0,
