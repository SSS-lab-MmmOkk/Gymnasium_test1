        "unit": "g"
      },
      "HighPerformance": {
        "value": 0.8,
        "unit": "g"
      }
    },
    "C3_1_Friction": {
      "Wet": {
        "dist": "beta",
        "alpha": 2,
        "beta": 5,
        "scale_min": 0.4,
        "scale_max": 0.7
      },
      "Dry": {
        "dist": "beta",
        "alpha": 5,
        "beta": 2,
        "scale_min": 0.7,
        "scale_max": 1.0
      }
    },
    "C3_2_Occlusion": {
      "None": {
        "value": false
      },
      "Present": {
        "value": true
      }
    },
    "R1_Outcome": {
      "rules": [
        {
          "state": "Collision",
          "condition": "MIN_DISTANCE <= 0.0"
        },
        {
          "state": "NearMiss",
          "condition": "ACTION == 'Pass' && MIN_DISTANCE > 0.0 && MIN_DISTANCE <= 1.5"
        },
        {
          "state": "CleanPass",
          "condition": "ACTION == 'Pass' && MIN_DISTANCE > 1.5"
        },
        {
          "state": "SafeStop",
          "condition": "ACTION == 'Stop' && MIN_DISTANCE > 0.0"
        }
      ]
    },
    "E_PET_Bin": {
      "rules": [
        {
          "state": "LT_1s",
          "condition": "PET < 1.0"
        },
        {
          "state": "GE_1s",
          "condition": "PET >= 1.0"
        }
      ]
    }
  },
  "schema_version": "1.0",
  "learning": {
    "method": "dirichlet_pseudocount",
    "update_condition": "R1_Outcome == 'NearMiss'",
    "target_nodes": [
      "C1_1_RelDist",
      "C1_2_WalkSpeed",
      "C1_3_CrossAngle",
      "C1_4_PedSize",
      "C2_1_InitSpeed",
      "C2_2_SensorDelay",
      "C2_3_PlanDelay",
      "C2_4_MaxDecel",
      "C3_1_Friction",
      "C3_2_Occlusion"
    ],
    "alpha0": "use_initial_probabilities_as_pseudocounts",
    "notes": "NearMissが出た試行で実際にサンプルされたL1状態をカウントし、事前確率を更新する。"
  },
  "cpt_matching": {
    "rule_priority": [
      "most_specific_fewest_Any",
      "first_defined_wins",
      "fallback_default"
    ]
  }
}
